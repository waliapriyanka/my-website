<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Walia Priyanka K | Accounting & Finance</title>
  <meta name="description" content="Personal portfolio of Walia Priyanka K, HKU Accounting and Finance graduate.">

  <style>
    :root {
      --primary: #1f5ea8;
      --primary-dark: #174675;
      --accent: #eaf2fb;
      --text: #243447;
      --muted: #66758a;
      --border: #dde5ed;
      --background: #f7f9fc;
      --white: #ffffff;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      color: var(--text);
      background: var(--background);
      line-height: 1.6;
    }

    a {
      color: var(--primary);
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    .page {
      max-width: 1120px;
      margin: 32px auto;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 12px 35px rgba(35, 62, 89, 0.08);
    }

    .container {
      display: grid;
      grid-template-columns: 260px 1fr;
    }

    .sidebar {
      padding: 36px 28px;
      background: #fbfdff;
      border-right: 1px solid var(--border);
    }

    .profile-mark {
      width: 110px;
      height: 110px;
      margin: 0 auto 20px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--accent);
      color: var(--primary);
      font-size: 38px;
      font-weight: 700;
    }

    .sidebar h2 {
      margin: 0 0 8px;
      text-align: center;
      font-size: 21px;
    }

    .sidebar .education {
      color: var(--muted);
      font-size: 14px;
      text-align: center;
    }

    .contact-links {
      list-style: none;
      padding: 0;
      margin: 22px 0 0;
      font-size: 14px;
    }

    .contact-links li {
      margin: 8px 0;
    }

    .content {
      padding: 42px 48px;
    }

    h1 {
      margin: 0 0 8px;
      color: #1d2f43;
      font-size: 38px;
      line-height: 1.2;
    }

    .tagline {
      max-width: 720px;
      margin: 0 0 16px;
      color: var(--muted);
      font-size: 18px;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 16px 0 24px;
    }

    .tag {
      padding: 7px 12px;
      border-radius: 999px;
      background: var(--accent);
      color: var(--primary-dark);
      font-size: 13px;
      font-weight: 700;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .button {
      display: inline-block;
      padding: 9px 16px;
      border: 1px solid var(--primary);
      border-radius: 7px;
      background: var(--primary);
      color: white;
      font-weight: 700;
    }

    .button.secondary {
      background: white;
      color: var(--primary);
    }

    section {
      margin-top: 32px;
    }

    h2 {
      margin: 0 0 14px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
      color: #365a82;
      font-size: 13px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }

    .entry {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 16px;
      margin-bottom: 18px;
    }

    .entry h3 {
      margin: 0 0 4px;
      color: #1e3145;
      font-size: 17px;
    }

    .entry .date {
      color: var(--muted);
      white-space: nowrap;
      font-size: 13px;
    }

    ul {
      margin: 8px 0 0;
      padding-left: 20px;
    }

    .placeholder-note {
      display: inline-block;
      margin-bottom: 8px;
      padding: 3px 8px;
      border-radius: 5px;
      background: #fff4d6;
      color: #806000;
      font-size: 12px;
    }

    .projects {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .project {
      min-height: 230px;
      padding: 18px;
      border: 1px solid var(--border);
      border-radius: 9px;
      background: #fcfdff;
    }

    .project h3 {
      margin: 0 0 10px;
      font-size: 17px;
    }

    .project p {
      margin: 8px 0;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: 130px 1fr;
      row-gap: 8px;
    }

    .skills-grid strong {
      color: #365a82;
    }

    .footer {
      padding: 18px;
      border-top: 1px solid var(--border);
      color: var(--muted);
      text-align: center;
      font-size: 13px;
    }

    @media (max-width: 800px) {
      .page {
        margin: 0;
        border: none;
        border-radius: 0;
      }

      .container {
        grid-template-columns: 1fr;
      }

      .sidebar {
        border-right: none;
        border-bottom: 1px solid var(--border);
      }

      .content {
        padding: 30px 24px;
      }

      .projects {
        grid-template-columns: 1fr;
      }

      h1 {
        font-size: 32px;
      }

      .entry {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

